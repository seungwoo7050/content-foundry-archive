{
  "name": "content-foundry-public-sites",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.x"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:static": "turbo run verify:static",
    "validate:release": "pnpm --filter @content-foundry/content-contract build && pnpm --filter @content-foundry/content-contract validate:release"
  },
  "devDependencies": {
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  }
}
