{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "RELEASE_MODE",
        "CONTENT_RELEASE_DIR",
        "SITE_ORIGIN",
        "ENABLE_ANALYTICS",
        "ENABLE_ADS"
      ],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "verify:static": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
