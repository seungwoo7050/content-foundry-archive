{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "RELEASE_MODE",
        "CONTENT_RELEASE_DIR",
        "SITE_ORIGIN",
        "SITE_ALLOWED_PRODUCTION_ORIGINS",
        "CONSENT_PROVIDER",
        "CONSENT_CONFIG_REVISION",
        "GOOGLE_CMP_READY",
        "ENABLE_ANALYTICS",
        "SITE_OWNED_GA4_MEASUREMENT_ID",
        "ENABLE_ADS",
        "SITE_OWNED_ADSENSE_CLIENT_ID",
        "ADSENSE_MANUAL_UNITS",
        "ADSENSE_AUTO_ADS_ENABLED",
        "ADSENSE_SITE_READY"
      ],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "@content-foundry/site-a#build": {
      "dependsOn": ["^build"],
      "env": [
        "RELEASE_MODE",
        "CONTENT_RELEASE_DIR",
        "IMMUTABLE_MEDIA_DIR",
        "SITE_ORIGIN",
        "SITE_ALLOWED_PRODUCTION_ORIGINS",
        "CONSENT_PROVIDER",
        "CONSENT_CONFIG_REVISION",
        "GOOGLE_CMP_READY",
        "ENABLE_ANALYTICS",
        "SITE_OWNED_GA4_MEASUREMENT_ID",
        "ENABLE_ADS",
        "SITE_OWNED_ADSENSE_CLIENT_ID",
        "ADSENSE_MANUAL_UNITS",
        "ADSENSE_AUTO_ADS_ENABLED",
        "ADSENSE_SITE_READY"
      ],
      "outputs": [".next/**", "out/**", ".site-build/**", "public/_media/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "verify:static": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
