{
  "name": "@content-foundry/site-a",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run prepare:release && next build",
    "dev": "pnpm run prepare:release && next dev",
    "lint": "eslint . && stylelint \"app/**/*.css\" --allow-empty-input",
    "prepare:release": "tsx scripts/prepare-site-release.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "verify:static": "node scripts/verify-static.mjs"
  },
  "dependencies": {
    "@content-foundry/content-contract": "workspace:*",
    "@content-foundry/media": "workspace:*",
    "@content-foundry/site-core": "workspace:*",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
