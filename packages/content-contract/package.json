{
  "name": "@content-foundry/content-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run check:generated && tsc -p tsconfig.build.json",
    "generate:types": "node scripts/generate-types.mjs",
    "check:generated": "node scripts/generate-types.mjs --check",
    "lint": "node --check scripts/generate-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
