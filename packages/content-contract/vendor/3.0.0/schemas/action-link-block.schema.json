{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-foundry.example/contracts/3.0.0/action-link-block.schema.json",
  "title": "Published Action Link Block",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "label", "path"],
      "properties": {
        "type": {"const": "action-link"},
        "kind": {"const": "internal"},
        "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "path": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*)?$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "label", "url"],
      "properties": {
        "type": {"const": "action-link"},
        "kind": {"enum": ["official", "affiliate"]},
        "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  ]
}
