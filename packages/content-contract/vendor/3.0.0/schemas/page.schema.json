{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-foundry.example/contracts/3.0.0/page.schema.json",
  "title": "Published Static Page Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "path", "title", "summary", "content", "seo"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "content": {"$ref": "content.schema.json"},
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "canonicalPath", "index", "follow"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "canonicalPath": {
          "type": "string",
          "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
        },
        "index": {"type": "boolean"},
        "follow": {"type": "boolean"}
      }
    }
  }
}
