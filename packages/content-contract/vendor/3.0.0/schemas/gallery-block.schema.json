{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-foundry.example/contracts/3.0.0/gallery-block.schema.json",
  "title": "Published Gallery Block",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "items"],
  "properties": {
    "type": {"const": "gallery"},
    "caption": {"type": ["string", "null"], "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mediaId"],
        "properties": {
          "mediaId": {"type": "string", "minLength": 1},
          "caption": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
