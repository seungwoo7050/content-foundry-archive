{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-foundry.example/contracts/2.0.0/site.schema.json",
  "title": "Public Site Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origin",
    "locale",
    "timeZone",
    "name",
    "shortName",
    "description",
    "defaultTheme",
    "defaultSkin",
    "author",
    "analytics",
    "ads",
    "search",
    "featureFlags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "defaultTheme": {
      "enum": [
        "editorial-utility",
        "clean-personal-blog",
        "information-portal",
        "minimal-knowledge-base",
        "friendly-mobile-utility"
      ]
    },
    "defaultSkin": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "profileId"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "publicMeasurementId"
      ],
      "properties": {
        "provider": {
          "enum": [
            "disabled",
            "ga4"
          ]
        },
        "publicMeasurementId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "enabled",
        "publicClientId"
      ],
      "properties": {
        "provider": {
          "enum": [
            "disabled",
            "adsense",
            "other"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "publicClientId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "featureFlags": {
      "type": "object"
    }
  }
}
